    "lexicalSelectionRules": [
      {
        "id": "SAT-LANG-001",
        "rule": "Use `structure` as the default verb when no query-specific domain is active."
      },
      {
        "id": "SAT-LANG-002",
        "rule": "Use `take responsibility` when accountability, duty, authority, or return themes are primary."
      },
      {
        "id": "SAT-LANG-003",
        "rule": "Use `stabilize` or `make sustainable` when Saturn is the object of Uranus, Mars, Jupiter, or Neptune."
      },
      {
        "id": "SAT-LANG-004",
        "rule": "Use `define limits` when boundaries, resources, health routines, or relational commitments are central."
      },
      {
        "id": "SAT-LANG-005",
        "rule": "Use `consolidate` when Saturn is working with resources, knowledge, power, or accumulated effort."
      },
      {
        "id": "SAT-LANG-006",
        "rule": "Use `mature` only when development over time is explicitly part of the composition."
      },
      {
        "id": "SAT-LANG-007",
        "rule": "Never use `punish`, `deny`, or `suffer` as neutral Saturn verbs."
      }
    ],
