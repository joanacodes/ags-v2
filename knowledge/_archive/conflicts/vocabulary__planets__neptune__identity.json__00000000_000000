    "coreFunction": {
      "primaryVerb": "permeate",
      "definition": "Allow feeling, meaning, image, identity, sensation, or experience to pass across a boundary that would otherwise remain more separate.",
      "functionalAim": "Increase receptivity, symbolic resonance, empathy, imagination, and participation across boundaries without inherently determining whether the result is clarifying, creative, confusing, or dissolving."
    },
    "coreQuestions": [
      "What is passing across this boundary?",
      "Which separation is becoming more permeable?",
      "What can be sensed indirectly rather than literally?",
      "Where does imagination enter perception?",
      "What remains distinct even while contact deepens?"
    ],
    "functionalContributions": [
      "permeability",
      "attunement",
      "resonance",
      "imagination",
      "symbolic association",
      "empathy",
      "diffusion",
      "surrender",
      "inspiration",
      "nonliteral perception",
      "boundary softening",
      "participation in a larger field"
    ],
    "doesNotInherentlySupply": [
      "confusion",
      "deception",
      "spiritual truth",
      "moral goodness",
      "self-sacrifice",
      "dissociation",
      "fantasy",
      "artistic talent",
      "psychic accuracy",
      "loss of identity",
      "lack of discernment"
    ],
    "planetaryBoundaries": [
      {
        "neighbor": "moon",
        "distinction": "The Moon receives, feels, and regulates personal experience. Neptune makes emotional and imaginal boundaries more permeable."
      },
      {
        "neighbor": "mercury",
        "distinction": "Mercury distinguishes, compares, translates, and communicates. Neptune allows categories and meanings to overlap, resonate, and become nonliteral."
      },
      {
        "neighbor": "venus",
        "distinction": "Venus values, attracts, and relates. Neptune increases permeability between self, ideal, image, and other without deciding what is valuable."
      },
      {
        "neighbor": "jupiter",
        "distinction": "Jupiter expands meaning and belief. Neptune permeates boundaries between literal and symbolic meaning, individual and collective experience, or self and ideal."
      },
      {
        "neighbor": "saturn",
        "distinction": "Saturn defines and stabilizes boundaries. Neptune makes boundaries more permeable. Neither function automatically defeats the other."
      },
      {
        "neighbor": "uranus",
        "distinction": "Uranus reconfigures systems and operating patterns. Neptune permeates boundaries within or between systems."
      },
      {
        "neighbor": "pluto",
        "distinction": "Pluto transforms through exposure, elimination, compulsion, and regeneration. Neptune changes boundary conditions without necessarily eliminating or regenerating."
      }
    ],
    "identityConstraints": [
      "Neptune must remain a function-bearing actor.",
      "Its default function is permeability, not confusion.",
      "Dissolution is one possible degree or outcome of permeability, not the whole identity.",
      "Empathy must be distinguished from self-erasure.",
      "Imagination must be distinguished from factual accuracy.",
      "Symbolic perception must be distinguished from literal prediction.",
      "The function must remain reusable across all signs, houses, aspects, states, and queries."
    ]
