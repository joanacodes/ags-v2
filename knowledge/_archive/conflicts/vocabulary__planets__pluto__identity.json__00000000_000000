    "planetaryBoundaries": [
      {
        "neighbor": "mars",
        "distinction": "Mars initiates, asserts, cuts, and pursues. Pluto concentrates and regenerates by exposing and reorganizing deeper power, attachment, resource, and survival patterns."
      },
      {
        "neighbor": "saturn",
        "distinction": "Saturn structures, contains, and stabilizes. Pluto tests whether the structure remains viable and regenerates what cannot be sustained unchanged."
      },
