      ],
      "love": [
        "differentiation",
        "liberation",
        "interruption"
      ],
      "family": [
        "differentiation",
        "reform",
        "discontinuity"
      ],
      "friendship": [
        "networking",
        "decentralization",
        "differentiation"
      ],
      "health": [
        "interruption",
        "adaptation",
        "experimentation"
      ],
      "wounds_and_healing": [
        "liberation",
        "differentiation",
        "reconfiguration"
      ],
      "saturn_return": [
        "reform",
        "reconfiguration",
        "experimentation",
        "systems_awareness"
      ]
    },
    "semanticExclusions": [
      "Do not derive chaos from reconfiguration.",
      "Do not derive moral progress from innovation.",
      "Do not derive isolation from differentiation.",
      "Do not derive irresponsibility from liberation.",
      "Do not derive genius from systems awareness.",
      "Do not derive successful reform from interruption.",
      "Do not derive a sudden external event from discontinuity alone."
    ]
  },
