    "planetaryBoundaries": [
      {
        "neighbor": "mercury",
        "distinction": "Mercury understands, compares, translates, and communicates within or between systems. Uranus questions the system's assumptions and changes its configuration."
      },
      {
        "neighbor": "mars",
        "distinction": "Mars initiates and asserts action. Uranus changes the operating pattern, often by introducing a different option, architecture, or rule."
      },
      {
        "neighbor": "saturn",
        "distinction": "Saturn structures, stabilizes, and maintains. Uranus reconfigures, differentiates, and updates. Neither function cancels the other."
      },
      {
        "neighbor": "pluto",
        "distinction": "Pluto transforms through exposure, elimination, compulsion, and regeneration. Uranus transforms through reconfiguration, discontinuity, and alternative design."
      },
      {
        "neighbor": "jupiter",
        "distinction": "Jupiter expands range, meaning, and possibility. Uranus changes the pattern through which possibilities are organized."
      }
    ],
    "identityConstraints": [
      "Uranus must remain a function-bearing actor.",
      "Its default function is reconfiguration, not destruction.",
      "Disruption is a possible mechanism or observable effect, not the full identity.",
      "Innovation must be distinguished from novelty.",
      "Freedom must be distinguished from avoidance of commitment.",
      "The function must remain reusable across all signs, houses, aspects, and queries."
