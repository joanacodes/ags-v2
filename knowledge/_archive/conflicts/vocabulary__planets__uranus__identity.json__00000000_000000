    "coreFunction": {
      "primaryVerb": "reconfigure",
      "definition": "Alter the organization, assumptions, or operating pattern of an existing system so that a different possibility can emerge.",
      "functionalAim": "Increase freedom, adaptability, differentiation, and responsiveness by changing a pattern that has become limiting, obsolete, overdetermined, or closed."
    },
    "coreQuestions": [
      "What else is possible?",
      "Which assumption can be changed?",
      "Where has a system become too fixed?",
      "What new arrangement would create greater freedom or responsiveness?",
      "Which pattern needs interruption before it can be reconsidered?"
    ],
