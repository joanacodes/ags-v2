        "idealization",
        "diffusion",
        "imagination"
      ],
      "love": [
        "empathy",
        "idealization",
        "boundary_softening",
        "resonance"
      ],
      "family": [
        "empathy",
        "absorption",
        "boundary_softening"
      ],
      "friendship": [
        "resonance",
        "empathy",
        "attunement"
      ],
      "health": [
        "absorption",
        "diffusion",
        "boundary_softening"
      ],
      "wounds_and_healing": [
        "empathy",
        "surrender",
        "boundary_softening",
        "dissolution"
      ],
      "saturn_return": [
        "surrender",
        "boundary_softening",
        "idealization",
        "permeability"
      ]
    },
    "semanticExclusions": [
      "Do not derive confusion from permeability alone.",
      "Do not derive deception from imagination.",
      "Do not derive psychic accuracy from attunement.",
      "Do not derive self-sacrifice from empathy.",
      "Do not derive spiritual truth from resonance.",
      "Do not derive helplessness from surrender.",
      "Do not derive total boundary loss from boundary softening."
    ]
  },
