  "content": {
    "observableExpressionTypes": [
      {
        "id": "system_questioning",
        "definition": "Makes assumptions, rules, dependencies, or design choices available for reconsideration."
      },
      {
        "id": "alternative_design",
        "definition": "Proposes or tests a different operating arrangement."
      },
      {
        "id": "pattern_interruption",
        "definition": "Breaks continuity long enough to expose a hidden pattern or option."
      },
      {
        "id": "differentiated_participation",
        "definition": "Participates without fully conforming to inherited expectations."
      },
      {
        "id": "networked_coordination",
        "definition": "Coordinates across multiple nodes rather than one center."
      },
      {
        "id": "future_adaptation",
        "definition": "Updates present systems in response to emerging conditions."
      }
    ],
    "stageExpressionProfiles": [
      {
        "stage": "unconscious",
        "externalComponents": [
          "abrupt changes of direction",
          "unexplained withdrawal from repetition",
          "automatic resistance to imposed sameness",
          "inconsistent continuity",
          "difference expressed before it is articulated"
        ],
        "internalComponents": [
          "pressure for space",
          "restlessness under repetition",
          "sensitivity to restriction",
          "rapid detection of alternatives"
        ],
        "selectionConstraints": [
          "Do not infer intention.",
          "Do not infer pathology.",
          "Do not assume every discontinuity is Uranian."
        ]
      },
      {
        "stage": "defensive",
        "externalComponents": [
          "contrarian positioning",
          "provocation",
          "premature departure",
          "unannounced disruption",
          "refusal of coordination",
          "change without transition planning"
        ],
        "internalComponents": [
          "fear of being controlled",
          "fear of absorption",
          "need to restore agency quickly",
          "identification with unpredictability"
        ],
        "selectionConstraints": [
          "Requires explicit defensive evidence.",
          "Must not be used as neutral Uranus description."
        ]
      },
      {
        "stage": "learning",
        "externalComponents": [
          "small-scale experiments",
          "prototype creation",
          "revision after feedback",
          "conscious nonconformity",
          "selective interruption",
          "testing decentralized methods"
        ],
        "internalComponents": [
          "curiosity about alternatives",
          "growing tolerance for continuity",
          "willingness to remain accountable",
          "effort to distinguish novelty from function"
        ],
        "selectionConstraints": [
          "Use when practice, testing, or revision is explicit."
        ]
      },
      {
        "stage": "healthy",
        "externalComponents": [
          "workable innovation",
          "system reform",
          "clear differentiation",
          "responsive decentralization",
          "future-oriented planning",
          "selective liberation from obsolete rules"
        ],
        "internalComponents": [
          "stable autonomy",
          "systems awareness",
          "openness to feedback",
          "capacity to preserve useful continuity"
        ],
        "selectionConstraints": [
          "Neutral mature default when no other stage is specified."
        ]
      },
      {
        "stage": "integrated",
        "externalComponents": [
          "sustainable reconfiguration",
          "distributed accountability",
          "innovation that becomes transferable practice",
          "change designed around human and systemic consequences",
          "difference held inside durable collaboration"
        ],
        "internalComponents": [
          "freedom without reflexive escape",
          "detachment without disconnection",
          "future orientation grounded in present reality",
          "capacity to stop changing once a system works"
        ],
        "selectionConstraints": [
          "Requires explicit integration evidence."
        ]
      }
