    "expressionConstraints": [
      "Observable intensity is not proof of Pluto.",
      "Privacy is not proof of secrecy or manipulation.",
      "Power language must identify actors, resources, or leverage.",
      "Crisis is not required for regeneration.",
      "No expression profile may become a finished placement interpretation."
    ]
