  "content": {
    "observableExpressionTypes": [
      {
        "id": "hidden_pattern_exposure",
        "definition": "Makes concealed motives, dependencies, risks, or resource structures visible."
      },
      {
        "id": "precision_elimination",
        "definition": "Removes a defined component that prevents viability or renewal."
      },
      {
        "id": "agency_reclamation",
        "definition": "Recovers choice, resource, voice, or capacity from suppression or dependency."
      },
      {
        "id": "power_redistribution",
        "definition": "Changes how leverage, risk, information, and decision-making capacity are distributed."
      },
      {
        "id": "deep_restructuring",
        "definition": "Reorganizes the internal distribution of power, attachment, or resource."
      },
      {
        "id": "shadow_integration",
        "definition": "Incorporates previously excluded, denied, feared, or concealed material."
      }
    ],
    "stageExpressionProfiles": [
      {
        "stage": "unconscious",
        "externalComponents": [
          "intense focus on hidden risks",
          "withholding information or emotion",
          "automatic testing of trust",
          "difficulty disengaging from perceived threat",
          "repetition of survival-based power patterns"
        ],
        "internalComponents": [
          "pressure to regain control",
          "sensitivity to concealed motives",
          "fear of irreversible loss",
          "concentration around vulnerability"
        ],
        "selectionConstraints": [
          "Do not infer abuse or trauma.",
          "Do not infer malicious intent.",
          "Do not assume intensity proves Pluto."
        ]
      },
      {
        "stage": "defensive",
        "externalComponents": [
          "coercive control",
          "retaliation",
          "punitive exposure",
          "information monopolization",
          "dominating resource access",
          "destructive all-or-nothing responses"
        ],
        "internalComponents": [
          "fear of powerlessness",
          "fear of humiliation",
          "identification with leverage",
          "belief that vulnerability invites annihilation"
        ],
        "selectionConstraints": [
          "Requires explicit defensive evidence.",
          "Must not be used as neutral Pluto description."
        ]
      },
      {
        "stage": "learning",
        "externalComponents": [
          "direct investigation",
          "selective disclosure",
          "clearer power mapping",
          "recovery of personal agency",
          "ending nonviable arrangements",
          "integration after conflict or loss"
        ],
        "internalComponents": [
          "growing tolerance for vulnerability",
          "willingness to release total control",
          "increasing precision about what must end",
          "capacity to distinguish reclamation from revenge"
        ],
        "selectionConstraints": [
          "Use when investigation, repair, or conscious restructuring is explicit."
        ]
      },
      {
        "stage": "healthy",
        "externalComponents": [
          "accountable exposure",
          "precise elimination",
          "resource reclamation",
          "deep restructuring",
          "transparent power redistribution",
          "integration of previously excluded material"
        ],
        "internalComponents": [
          "stable agency",
          "consequence awareness",
          "capacity to tolerate irreversible change",
          "reduced dependence on crisis intensity"
        ],
        "selectionConstraints": [
          "Neutral mature default when no other stage is specified."
        ]
      },
      {
        "stage": "integrated",
        "externalComponents": [
          "regeneration without domination",
          "truth-telling without humiliation",
          "shared power and accountability",
          "resilient restructuring after loss",
          "precise endings that protect what remains viable"
        ],
        "internalComponents": [
          "agency without coercion",
          "depth without obsession",
          "power without moral superiority",
          "capacity to complete transformation and move on"
        ],
        "selectionConstraints": [
          "Requires explicit integration evidence."
        ]
      }
    ],
