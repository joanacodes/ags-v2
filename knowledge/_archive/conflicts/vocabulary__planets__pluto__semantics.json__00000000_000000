    "semanticExclusions": [
      "Do not derive physical death from regeneration.",
      "Do not derive trauma from exposure.",
      "Do not derive abuse from power redistribution.",
      "Do not derive truth from intensity.",
      "Do not derive moral purity from purification.",
      "Do not derive inevitability from irreversibility.",
      "Do not derive transformation from crisis alone."
    ]
