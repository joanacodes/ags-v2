      "expectedRole": "modifier"
    },
    {
      "id": "SIGN-T-002",
      "name": "Reject finished interpretation",
      "input": "Saturn structures compassionately through surrender.",
      "expectedValid": false
    },
    {
      "id": "SIGN-T-003",
      "name": "Reject planetary verb in sign identity",
      "expectedValid": false
    },
    {
      "id": "SIGN-T-004",
      "name": "Allow adverbial component",
      "input": "directly",
      "expectedValid": true
    },
    {
      "id": "SIGN-T-005",
      "name": "Require compatibility metadata",
      "expectedValid": false
    },
    {
      "id": "SIGN-T-006",
      "name": "Defensive modifier requires evidence",
      "expectedValid": false
    },
    {
      "id": "SIGN-T-007",
      "name": "Sign does not replace target verb",
      "expectedSame": true
    },
    {
      "id": "SIGN-T-008",
      "name": "Deterministic modifier selection",
      "expectedSameModifierIds": true
    }
