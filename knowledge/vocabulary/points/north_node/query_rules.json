    "selectionRules": [
      {
        "id": "NN-QUERY-001",
        "rule": "Default to `develop` when no narrower approved developmental verb is justified."
      },
      {
        "id": "NN-QUERY-002",
        "rule": "Always load and represent the South Node before generating North Node output."
      },
      {
        "id": "NN-QUERY-003",
        "rule": "Use `practice` when repetition, training, or feedback is explicit."
      },
      {
        "id": "NN-QUERY-004",
        "rule": "Use `integrate` only when the South Node resource remains visible."
      },
      {
        "id": "NN-QUERY-005",
        "rule": "Use overreliance language only when contextual evidence supports it."
      },
      {
        "id": "NN-QUERY-006",
        "rule": "Never convert developmental direction into predicted outcome, destiny, or moral command."
      }
    ],
    "queryConstraints": [
      "Queries may prioritize domains but may not redefine the North Node.",
      "No query authorizes abandonment of the South Node.",
      "No query authorizes guaranteed fulfillment.",
      "No query authorizes factual past-life claims."
    ]
  },
  "provenance": {
    "method": "AGS point ontology development",
    "sourcePolicy": "Developmental-direction vocabulary only. No destiny, fate, moral ranking, or guaranteed outcome claims are permitted.",
    "maintainer": "AGS project"
