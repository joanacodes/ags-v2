    "prohibitedModifiers": [
      {
        "text": "violently",
        "reason": "Violence is not an inherent Aries modifier."
      },
      {
        "text": "selfishly",
        "reason": "Self-focus and selfishness are not equivalent."
      },
      {
        "text": "recklessly",
        "reason": "Recklessness is a possible defensive expression, not a neutral component."
      },
      {
        "text": "angrily",
        "reason": "Anger may occur but does not define Aries as a modifier."
      },
      {
        "text": "immaturely",
        "reason": "Developmental judgment must come from expression stage, not sign identity."
      }
    ],
    "selectionRules": [
      {
        "id": "ARI-MOD-001",
        "rule": "Use `directly` as the default manner adverb."
      },
      {
        "id": "ARI-MOD-002",
        "rule": "Use `through initiation` when the planetary verb can meaningfully begin, launch, assert, or activate."
      },
      {
        "id": "ARI-MOD-003",
        "rule": "Use `independently` only when autonomy is relevant to the selected query or planetary function."
      },
      {
        "id": "ARI-MOD-004",
        "rule": "Do not select pace components when the planetary verb already contains speed or immediacy."
      },
      {
        "id": "ARI-MOD-005",
        "rule": "Defensive modifiers require an explicit developmental or stress condition."
      },
      {
        "id": "ARI-MOD-006",
        "rule": "Integrated modifiers require an explicit integration stage or synthesis rule."
      }
    ],
    "componentOnlyValidation": [
      "No entry may contain a grammatical subject plus conjugated planetary verb.",
      "No entry may mention a specific house.",
      "No entry may mention a specific aspect.",
      "No entry may claim a complete life outcome.",
      "No entry may function as a complete placement reading."
    ]
