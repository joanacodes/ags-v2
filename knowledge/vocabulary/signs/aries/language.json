    "rejectedWording": [
      {
        "text": "Aries acts.",
        "reason": "A sign modifies action; it does not supply action."
      },
      {
        "text": "Aries is aggressive.",
        "reason": "Aggression is not the neutral modifier profile."
      },
      {
        "text": "Aries makes people selfish.",
        "reason": "This is a deterministic personality claim."
      },
      {
        "text": "Aries always leads.",
        "reason": "First-move priority does not guarantee leadership."
      },
      {
        "text": "Mars in Aries acts courageously.",
        "reason": "This is a completed placement interpretation."
      }
    ],
    "selectionRules": [
      "Prefer `directly` as the default neutral manner modifier.",
      "Prefer `through initiation` when strategy must be explicit.",
      "Use `rapidly` only when target compatibility permits speed.",
      "Use defensive wording only with defensive evidence.",
      "Never use aggression, selfishness, courage, or leadership as neutral defaults."
