{
  "$schemaVersion": "0.1.0",
  "id": "midheaven_query_rules",
  "name": "Midheaven Query Rules",
  "type": "angle_module",
  "status": "draft_for_review",
  "language": "en",
  "description": "Defines query-specific actualization domains, verb preferences, and public-role constraints.",
  "grammarRole": "reference_frame",
  "compliesWith": [
    "LAW-001",
    "LAW-003",
    "LAW-004",
    "LAW-005",
    "LAW-012",
    "LAW-013",
    "LAW-014",
    "LAW-017",
    "LAW-019",
    "LAW-020"
  ],
  "dependsOn": [
