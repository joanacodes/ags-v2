    "technicalFragments": [
      "The Ascendant supplies the orientation reference frame.",
      "The Ascendant establishes the initial approach to experience.",
      "The Ascendant frames first contact between self and environment.",
      "The Ascendant receives sign modification and ruler delegation.",
      "The Ascendant does not supply a planetary action."
    ],
    "firstPersonFragments": [
      "I orient",
      "I approach",
      "I position myself",
      "I begin engagement",
      "I enter"
    ],
    "learningFragments": [
      "I am learning to orient without reducing myself to first impressions",
      "I am learning to approach experience without overcontrolling presentation",
      "I am learning to distinguish orientation from identity",
      "I am learning to coordinate self-positioning with relational awareness"
    ],
    "lexicalSelectionRules": [
      {
        "id": "ASC-LANG-001",
        "rule": "Use `orient` when no narrower angle function is justified."
      },
      {
        "id": "ASC-LANG-002",
        "rule": "Use `approach` when movement toward experience is foregrounded."
      },
      {
        "id": "ASC-LANG-003",
        "rule": "Use `present` only for observable embodiment or presentation."
      },
      {
        "id": "ASC-LANG-004",
        "rule": "Use `mask` only with explicit defensive concealment evidence."
      },
      {
        "id": "ASC-LANG-005",
        "rule": "Never equate orientation with total personality or identity."
      }
    ],
    "rejectedWording": [
      {
        "text": "The Ascendant is your personality.",
        "reason": "The Ascendant establishes orientation; it does not contain the entire personality."
      },
      {
        "text": "The Ascendant is your mask.",
        "reason": "Masking is one possible defensive presentation, not the neutral function."
      },
      {
        "text": "Your rising sign determines your appearance.",
        "reason": "Appearance cannot be guaranteed from the Ascendant alone."
      },
      {
        "text": "The Ascendant is the real you.",
        "reason": "The angle is a reference frame, not total identity."
      }
    ]
  },
  "provenance": {
