        "through inherited beliefs",
        "within unquestioned assumptions"
      ],
      "defensive": [
        "through rigid certainty",
        "within ideological attachment"
      ],
      "learning": [
        "through expanding understanding",
        "within active exploration"
      ],
      "healthy": [
        "through open inquiry",
        "within integrated learning"
      ],
      "integrated": [
        "through adaptive wisdom",
        "within lifelong exploration"
      ]
    },
    "constraints": [
      "Defensive wording requires explicit evidence.",
      "Integrated wording requires explicit evidence.",
      "Higher learning context never implies superiority."
    ]
  }
