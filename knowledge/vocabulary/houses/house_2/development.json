        "within overprotective stewardship"
      ],
      "learning": [
        "through developing values",
        "within responsible resource management"
      ],
      "healthy": [
        "through sustainable stewardship",
        "within coherent self-worth"
      ],
      "integrated": [
        "through adaptive value systems",
        "within resilient stewardship"
      ]
