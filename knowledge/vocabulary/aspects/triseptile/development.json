      "unconscious": [
        "latent convergence",
        "unrecognized coordination"
      ],
      "defensive": [
        "forced convergence",
        "rigid integration"
      ],
      "learning": [
        "recognizing convergent patterns",
        "adaptive coordination"
      ],
      "healthy": [
        "constructive systemic integration",
        "coherent convergence"
      ],
      "integrated": [
        "continuous recursive convergence",
        "stable emergent integration"
      ]
    },
    "constraints": [
      "Triseptile never becomes a canonical function.",
      "Participating functions retain identity."
    ]
  }
}