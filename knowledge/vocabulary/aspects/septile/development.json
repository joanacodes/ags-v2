        "latent recursive patterns",
        "unrecognized cycles"
      ],
      "defensive": [
        "rigid repetition",
        "resistance to reorganization"
      ],
      "learning": [
        "recognizing recurring structures",
        "adaptive coordination"
      ],
      "healthy": [
        "constructive recursive organization",
        "nonlinear integration"
      ],
      "integrated": [
        "continuous recursive refinement",
        "stable emergent organization"
      ]
    },
    "constraints": [
      "Septile never becomes a canonical function.",
      "Participating functions retain identity."
    ]
  }
