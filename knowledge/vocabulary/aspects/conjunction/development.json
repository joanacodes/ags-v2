  "parentObject": "conjunction",
  "content": {
    "coreRule": "Development changes how conjunction is managed, never its relational role.",
    "stages": {
      "unconscious": [
        "fusion without differentiation"
      ],
      "defensive": [
        "over-identification of functions"
      ],
      "learning": [
        "recognizing distinct functions within co-activation"
      ],
      "healthy": [
        "coordinated integration"
      ],
      "integrated": [
        "stable co-activation preserving each function"
      ]
    },
    "constraints": [
      "Conjunction never becomes a canonical function."
    ]
  }
}