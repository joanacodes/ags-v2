{
  "$schemaVersion": "0.1.0",
  "id": "moon_development",
  "moduleType": "development",
  "grammarRole": "canonical_function",
  "parentObject": "moon",
  "content": {
    "coreRule": "Development changes how the Moon's canonical function is expressed; the canonical function itself remains unchanged.",
    "stages": {
      "unconscious": [
        "needs expressed automatically",
        "reactive emotional regulation"
      ],
      "defensive": [
        "protective attachment strategies",
        "regulation constrained by insecurity"
      ],
      "learning": [
        "developing emotional awareness",
        "more adaptive responses"
      ],
      "healthy": [
        "secure regulation",
        "responsive attachment"
      ],
      "integrated": [
        "emotion, memory, and needs coordinated into adaptive responsiveness"
      ]
    },
    "constraints": [
      "Development never changes the canonical function.",
      "Integrated descriptions require supporting evidence."
    ]
  }
}