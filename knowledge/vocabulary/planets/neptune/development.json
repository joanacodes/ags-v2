  "content": {
    "coreRule": "Development changes how Neptune's canonical function is expressed; the canonical function itself remains unchanged.",
    "stages": {
      "unconscious": [
        "diffuse imagination",
        "unexamined idealization"
      ],
      "defensive": [
        "boundary dissolution without discernment",
        "escapist tendencies"
      ],
      "learning": [
        "developing symbolic understanding",
        "growing compassion"
      ],
      "healthy": [
        "integrated imagination",
        "compassion with discernment"
      ],
      "integrated": [
        "imagination, compassion, and transcendence aligned into coherent symbolic understanding"
      ]
    },
    "constraints": [
      "Development never changes the canonical function.",
      "Integrated descriptions require supporting evidence."
    ]
  }
}